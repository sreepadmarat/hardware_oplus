type esim_switcher_app, domain, coredomain;

app_domain(esim_switcher_app)
hal_client_domain(esim_switcher_app, vendor_hal_oplus_esim)
hal_client_domain(esim_switcher_app, vendor_hal_qspmhal)

allow esim_switcher_app app_api_service:service_manager find;
allow esim_switcher_app audioserver_service:service_manager find;
allow esim_switcher_app radio_service:service_manager find;

# Changed vendor_persist_nfc_prop to nfc_prop for AOSP Rom's
get_prop(esim_switcher_app, nfc_prop)
